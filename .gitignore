# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ---------------------------------------------------------------------------
# DeKYC — secrets (NEVER commit these)
# ---------------------------------------------------------------------------
# Patterns without a leading slash match at EVERY depth, so `.env` also covers
# `contracts/.env`. The `!.env.example` negation must stay AFTER `.env.*`,
# otherwise the committed placeholder templates would be ignored too.
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.keystore
*.jks
secrets.*
credentials.*
service-account*.json

# ---------------------------------------------------------------------------
# Build output & dependencies
# ---------------------------------------------------------------------------
node_modules/
build/
dist/
out/
.next/
coverage/

# Hardhat / TypeChain generated output
contracts/artifacts/
contracts/cache/
contracts/typechain-types/

# Python (in case tooling is ever added alongside)
.venv/
venv/
__pycache__/

# ---------------------------------------------------------------------------
# Local databases, dumps and OS cruft
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
Thumbs.db

# ---------------------------------------------------------------------------
# Large media / datasets — GitHub hard-rejects >100 MB and warns over 50 MB.
# Keep binaries out of the repo; link them from the README instead.
# ---------------------------------------------------------------------------
*.mp4
*.mov
*.zip
*.tar.gz
*.csv
*.parquet
