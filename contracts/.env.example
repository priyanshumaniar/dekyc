# ---------------------------------------------------------------------------
# DeKYC — contracts/.env  (copy this file to contracts/.env and fill in)
# NEVER commit the real .env. This .example file holds placeholders ONLY.
# ---------------------------------------------------------------------------

# HTTPS RPC endpoint for the Sepolia testnet (Infura / Alchemy).
# Must contain "sepolia". Mainnet URLs are not used anywhere in this project.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Private key of a FRESH test wallet that holds ONLY Sepolia ETH.
# 64 hex chars, with or without the 0x prefix. Used solely to deploy.
DEPLOYER_PRIVATE_KEY=0xYOUR_TEST_WALLET_PRIVATE_KEY

# Etherscan API key (unified V2 key works for Sepolia). Used for verification.
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
