# ---------------------------------------------------------------------------
# DeKYC — Flutter app .env  (copy to .env and fill in your own values)
# This .example holds PLACEHOLDERS ONLY. The real .env is gitignored.
# ---------------------------------------------------------------------------

# Sepolia RPC endpoint (same value you put in contracts/.env). Used by
# web3dart for read calls. Must contain "sepolia" — no mainnet.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# PREFERRED for any web deployment: URL of the DeKYC pinning proxy, which holds
# the Pinata JWT server-side so it is never shipped to the browser.
# Run it with:  PINATA_JWT=... node proxy/server.js     (see proxy/README.md)
# When this is set, PINATA_JWT below is ignored by the app.
# PINATA_PROXY_URL=http://localhost:8787/pin

# Pinata JWT (the long eyJ... token) used to pin encrypted KYC bundles to IPFS.
# Local development only: Flutter bundles .env as an app asset, so on a web
# build this value is downloadable by any visitor. Use PINATA_PROXY_URL instead.
PINATA_JWT=YOUR_PINATA_JWT

# Optional dedicated Pinata gateway host (e.g. your-name.mypinata.cloud).
# Leave as-is to use the public gateway.
PINATA_GATEWAY=gateway.pinata.cloud

# WalletConnect / Reown Cloud project id (connects the app to mobile wallets).
WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID
